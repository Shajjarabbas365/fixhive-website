# Copy to .env.local and fill in real values. Never commit real secrets.

# Google Search Console / site verification (HTML tag method alternative: use a meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 measurement ID, format G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher ID, format ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Contact form email provider API key (Resend, Postmark, SendGrid, etc.)
CONTACT_EMAIL_API_KEY=
